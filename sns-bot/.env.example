# job-world SNS bot 設定（ローカル検証用・認証情報は含めない）
# 本番（GitHub Actions）では認証情報を Secret Gist から読む。

# 認証情報の代わりにローカルファイルを使う場合（Gitignore 済み）
LOCAL_CRED_FILE=sns-bot/.credentials.local.json

# サイトURL（既定: https://job.antonbase.com）
# JOB_WORLD_SITE_URL=

# ハッシュタグ（既定: #珍しい仕事 #しごと図鑑）
# JOB_HASHTAGS=

# Threads トークンのリフレッシュ判定（デフォルト: 10日）
# REFRESH_BEFORE_DAYS=10
