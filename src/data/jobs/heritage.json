      "familiarity": 3,
      "lifecycle": "established",
      "edges": [
        {
          "to": "paleontologist",
          "kind": "confusable",
          "noteJa": "どちらも地面を掘って過去のものを出すが、発掘調査員は人の遺跡を、古生物学者は化石を扱う。"
        }
      ],
      "sources": [
