        "sense.fine-motor",
        "condition.apprenticeship",
        "condition.seasonal",
        "condition.few-practitioners",
        "temperament.repeatable",
        "temperament.quiet-pride",
        "industry.craft"
      ],
      "rarity": 4,
      "familiarity": 2,
      "lifecycle": "traditional",
      "sources": [
        {
          "titleJa": "全国竹工芸組合連合会",
          "url": "https://www.takezaiku.jp/"
        }
      ],
      "updatedAt": "2026-08-12"
    },
    {
      "slug": "barrel-maker",
      "nameJa": "桶職人",
      "nameEn": "Barrel Maker",
      "aliasesJa": [
        "樽職人",
        "桶屋"
      ],
      "kanaJa": "おけしょくにん",
      "emoji": "🛢️",
      "summaryJa": "水を漏らさない器を、木の板を削って円に組んで作る。",
      "descriptionJa": "桶や樽を作る職。木の板を鉋で削って角度を付け、円形に組み合わせて箍で締める。木と木の接合をすべて加工精度で行い、接着剤や釘に頼らない。水を入れて漏れない状態に仕上げるため、板の削り方と締めの強さの調整が職人の技術になる。木の板は気候によって膨張と収縮を繰り返すため、組み上げてからも手直しが続く。酒蔵や醤油蔵では、中の液体と木が馴染むまでの管理を任されることもある。",
      "surpriseJa": "桶職人は板を「わずかに弧が合う」ように削って円に組む。接合部はすべて鉋で作られ、箍で締めると水が漏れない。木の厚さが微妙に違うだけで円が歪むため、最後は水を入れて確かめる。",
      "howToBecomeJa": "桶工房に弟子入りし、鉋の技術と板の見方を学ぶ。",
      "tags": [
