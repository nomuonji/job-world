{
  "name": "job-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "data:build": "tsx scripts/build-data.ts",
    "data:validate": "tsx scripts/validate.ts",
    "data:check": "npm run data:build && git diff --exit-code -- src/data && npm run data:validate",
    "data:new": "tsx scripts/new-job.ts",
    "tag:new": "tsx scripts/new-tag.ts",
    "verify": "npm run data:check && npm run lint && npm run build"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.8",
    "typescript": "^5"
  }
}
